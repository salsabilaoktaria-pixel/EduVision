# =====================================================================
# CATATAN KEAMANAN UNTUK PRODUKSI (server sungguhan / online):
# Saat di-deploy ke server asli, WAJIB ubah baris di bawah ini:
#   APP_ENV=production
#   APP_DEBUG=false        <-- kalau tetap "true", error Laravel akan
#                               menampilkan isi kode & konfigurasi ke publik
#   SESSION_SECURE_COOKIE=true   (jika situs sudah pakai HTTPS)
# Untuk pengembangan di komputer lokal, nilai default di bawah ini aman
# dan boleh dibiarkan seperti ini.
# =====================================================================
APP_NAME=EduVision
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# PENTING: default Laravel pakai UTC, padahal Indonesia GMT+7 (WIB).
# Tanpa ini, jam absen/aktivitas lain akan tampil mundur 7 jam dari waktu asli.
# Sesuaikan zona kalau sekolahmu di WITA (Asia/Makassar) atau WIT (Asia/Jayapura).
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eduvision
DB_USERNAME=root
DB_PASSWORD=

FILESYSTEM_DISK=public

# Opsional — koordinat sekolah untuk validasi GPS absensi
SEKOLAH_LATITUDE=-2.990934
SEKOLAH_LONGITUDE=104.756554
SEKOLAH_RADIUS_METER=200

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync
